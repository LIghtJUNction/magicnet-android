# shellcheck shell=ash

export HOME=${MODDIR}
export KAM_HOME=${KAM_HOME:-${MODDIR}}
export KAMFW_DIR=${MODDIR}/lib/kamfw
# Keep framework snapshots and temporary downloads in the same private cache
# used by the CLI. Never inherit a manager/app-selected temporary directory.
export TMPDIR=${MODDIR}/.cache
# KernelSU executes module scripts in BusyBox ash standalone mode. The pinned
# x86_64 BusyBox sed applet segfaults on a valid UTF-8 multi-address regex.
# Explicit Android system tools bypass standalone applets while keeping
# ASH_STANDALONE semantics for every other command.
if [ -x /system/bin/sed ]; then
    sed() { /system/bin/sed "$@"; }
fi
# The module registry is shell-local. Child processes inherit names but not
# shell functions, so retaining an exported value makes imports disappear.
unset KAM_MODULES
KAM_MODULES=""
# Runtime logs belong to the module; customize.sh keeps its install log open
# while the manager controls the lifetime of the staging directory.
export KAM_LOGFILE=${KAM_LOGFILE:-${MODDIR}/.log/kam.log}
export MAGIC_SINGBOX="${MAGIC_SINGBOX:-1}"
