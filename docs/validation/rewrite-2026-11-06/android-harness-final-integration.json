    "local_patch": "diff --git a/scripts/android-device-simulation.py b/scripts/android-device-simulation.py\nindex eba2283..8d4389b 100644\n--- a/scripts/android-device-simulation.py\n+++ b/scripts/android-device-simulation.py\n@@ -247,7 +247,8 @@ def installed_controls(device, out: Path, evidence: dict) -> None:\n         service = machine('service status', 'service.status', 15)\n         supervisors = service.get('supervisors')\n         fswatch = supervisors.get('fswatch') if isinstance(supervisors, dict) else None\n-        require(isinstance(fswatch, str) and re.fullmatch(r'[1-9][0-9]{0,9}', fswatch) is not None,\n+        require(isinstance(fswatch, str) and re.fullmatch(r'[1-9][0-9]{0,9}', fswatch) is not None\n+                and int(fswatch) <= 2147483647,\n                 'installed fswatch supervisor is not confirmed running')\n         evidence['fswatch_running'] = True\n \ndiff --git a/scripts/test-android-device-simulation.py b/scripts/test-android-device-simulation.py\nindex afd09fd..33617d0 100644\n--- a/scripts/test-android-device-simulation.py\n+++ b/scripts/test-android-device-simulation.py\n@@ -299,6 +299,19 @@ class InstalledControlsTests(unittest.TestCase):\n                 self.assertEqual(self.evidence['stage'], 'service_status')\n         self.device.run.assert_not_called()\n \n+    def test_fswatch_pid_must_fit_runtime_range(self):\n+        for value in ('2147483648', '9999999999'):\n+            with self.subTest(value=value):\n+                self.service['supervisors']['fswatch'] = value\n+                with self.assertRaisesRegex(RuntimeError, 'not confirmed running'):\n+                    self.check()\n+                self.assertEqual(self.evidence['status'], 'failed')\n+                self.assertEqual(self.evidence['stage'], 'service_status')\n+        self.device.run.assert_not_called()\n+        self.service['supervisors']['fswatch'] = '2147483647'\n+        self.check()\n+        self.assertEqual(self.evidence['status'], 'passed')\n+\n     def test_machine_errors_wrong_schema_and_extra_stdout_are_rejected(self):\n         for args, name, data in (\n             ('service status', 'service.status', self.service),\n",
